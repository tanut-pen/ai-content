MCP_JENKINS_URL=
MCP_JENKINS_USERNAME=your_jenkins_username_here
MCP_JENKINS_PASSWORD=your_jenkins_password_here

# Open WebUI
WEBUI_SECRET_KEY=change-me-to-a-random-secret
